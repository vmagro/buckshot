"""Rule definitions + shared helpers for the versioned cxx toolchains.

The toolchain instances themselves live in versioned directories (one
generated BUCK per release, nothing else in each directory):

- `cxx/toolchains/<version>/BUCK` -- e.g. `cxx/toolchains/0.16.0`

with rolling `<major>.<minor>` aliases in the generated
`cxx/toolchains/BUCK` (each pointing at the latest patch release on
that minor). Generate a new release with
`buck2 run //buckshot -- cxx toolchain [--version X.Y.Z]` (the output
path defaults to the right versioned directory, and the rolling aliases
refresh automatically).

This package holds the rule definitions (`zig_toolchain.bzl`), the
wrapper program (`zig_tool_wrapper.py`, built as a
`python_bootstrap_binary` on the hermetic bootstrap interpreter and
shared by every versioned instance), the macOS SDK shim (also shared),
and the default `toolchain` alias that `toolchains//:cxx` resolves to.
It is hand-written: never pass it as `--output` (the generator refuses).
"""

load("@prelude//:rules.bzl", "export_file", "toolchain_alias")
load(":zig_toolchain.bzl", "macos_sdk_shim")

# Response-file flattener shared by every `zig <subcommand>` the toolchain
# drives (see zig_tool_wrapper.py). Runs on the hermetic bootstrap python,
# so it works identically on mac/linux/windows hosts with no sh/bash.
python_bootstrap_binary(
    name = "zig_tool_wrapper",
    main = "zig_tool_wrapper.py",
    visibility = ["PUBLIC"],
)

export_file(
    name = "libiconv.tbd",
    src = "macos/libiconv.tbd",
    visibility = [],
)

export_file(
    name = "libobjc.tbd",
    src = "macos/libobjc.tbd",
    visibility = [],
)

export_file(
    name = "AVFoundation.tbd",
    src = "macos/frameworks/AVFoundation.framework/AVFoundation.tbd",
    visibility = [],
)

export_file(
    name = "AppKit.tbd",
    src = "macos/frameworks/AppKit.framework/AppKit.tbd",
    visibility = [],
)

export_file(
    name = "CoreFoundation.tbd",
    src = "macos/frameworks/CoreFoundation.framework/CoreFoundation.tbd",
    visibility = [],
)

export_file(
    name = "CoreGraphics.tbd",
    src = "macos/frameworks/CoreGraphics.framework/CoreGraphics.tbd",
    visibility = [],
)

export_file(
    name = "CoreMedia.tbd",
    src = "macos/frameworks/CoreMedia.framework/CoreMedia.tbd",
    visibility = [],
)

export_file(
    name = "CoreVideo.tbd",
    src = "macos/frameworks/CoreVideo.framework/CoreVideo.tbd",
    visibility = [],
)

export_file(
    name = "Foundation.tbd",
    src = "macos/frameworks/Foundation.framework/Foundation.tbd",
    visibility = [],
)

export_file(
    name = "Metal.tbd",
    src = "macos/frameworks/Metal.framework/Metal.tbd",
    visibility = [],
)

export_file(
    name = "QuartzCore.tbd",
    src = "macos/frameworks/QuartzCore.framework/QuartzCore.tbd",
    visibility = [],
)

export_file(
    name = "Security.tbd",
    src = "macos/frameworks/Security.framework/Security.tbd",
    visibility = [],
)

export_file(
    name = "IOKit.tbd",
    src = "macos/frameworks/IOKit.framework/IOKit.tbd",
    visibility = [],
)

macos_sdk_shim(
    name = "macos_sdk_shim",
    libiconv_tbd = ":libiconv.tbd",
    libobjc_tbd = ":libobjc.tbd",
    framework_tbds = {
        "AVFoundation": ":AVFoundation.tbd",
        "AppKit": ":AppKit.tbd",
        "CoreFoundation": ":CoreFoundation.tbd",
        "CoreGraphics": ":CoreGraphics.tbd",
        "CoreMedia": ":CoreMedia.tbd",
        "CoreVideo": ":CoreVideo.tbd",
        "Foundation": ":Foundation.tbd",
        "Metal": ":Metal.tbd",
        "QuartzCore": ":QuartzCore.tbd",
        "Security": ":Security.tbd",
        "IOKit": ":IOKit.tbd",
    },
    visibility = ["PUBLIC"],
)

# The default cxx toolchain. Flip between the rolling `<major>.<minor>`
# aliases to change it.
toolchain_alias(
    name = "toolchain",
    actual = "buckshot//cxx/toolchains:0.16",
    visibility = ["PUBLIC"],
)
