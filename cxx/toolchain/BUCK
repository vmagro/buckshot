"""Rule definitions + shared helpers for the versioned cxx toolchains.

The toolchain instances themselves live in versioned directories (one
generated BUCK per release, nothing else in each directory):

- `cxx/toolchains/<version>/BUCK` -- e.g. `cxx/toolchains/0.16.0`

with rolling `<major>.<minor>` aliases in the generated
`cxx/toolchains/BUCK` (each pointing at the latest patch release on
that minor). Generate a new release with
`buck2 run //buckshot -- cxx toolchain [--version X.Y.Z]` (the output
path defaults to the right versioned directory, and the rolling aliases
refresh automatically).

This package holds the rule definitions (`zig_toolchain.bzl`), the
wrapper program (`zig_tool_wrapper.py`, built as a
`python_bootstrap_binary` on the hermetic bootstrap interpreter and
shared by every versioned instance), the macOS SDK shim (also shared),
and the default `toolchain` alias that `toolchains//:cxx` resolves to.
It is hand-written: never pass it as `--output` (the generator refuses).
"""

load("@prelude//:rules.bzl", "export_file", "toolchain_alias")
load(":zig_toolchain.bzl", "macos_sdk_shim")

# Response-file flattener shared by every `zig <subcommand>` the toolchain
# drives (see zig_tool_wrapper.py). Runs on the hermetic bootstrap python,
# so it works identically on mac/linux/windows hosts with no sh/bash.
python_bootstrap_binary(
    name = "zig_tool_wrapper",
    main = "zig_tool_wrapper.py",
    visibility = ["PUBLIC"],
)

export_file(
    name = "libiconv.tbd",
    src = "macos/libiconv.tbd",
    visibility = [],
)

macos_sdk_shim(
    name = "macos_sdk_shim",
    libiconv_tbd = ":libiconv.tbd",
    visibility = ["PUBLIC"],
)

# The default cxx toolchain. Flip between the rolling `<major>.<minor>`
# aliases to change it.
toolchain_alias(
    name = "toolchain",
    actual = "buckshot//cxx/toolchains:0.16",
    visibility = ["PUBLIC"],
)
