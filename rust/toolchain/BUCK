"""Rule definitions + shared helpers for the versioned rust toolchains.

The toolchain instances themselves live in versioned directories (one
generated BUCK per release, nothing else in each directory):

- `rust/toolchains/nightly/<date>/BUCK` -- dated nightly releases
- `rust/toolchains/stable/<version>/BUCK` -- stable releases

with rolling aliases in the generated `rust/toolchains/BUCK` (`nightly` =
latest nightly, `stable` = latest stable). Generate a new release with
`buck2 run //buckshot -- rust toolchain --channel-toml <url>` (the
output path defaults to the right versioned directory, and the rolling
aliases refresh automatically).

This package holds the rule definitions (`rust_dist.bzl`), the helper
programs (`*.py`, built as `python_bootstrap_binary` on the hermetic
bootstrap interpreter and shared by every versioned instance), and the
default `toolchain` alias that `toolchains//:rust` resolves to. It is
hand-written: never pass it as `--output` (the generator refuses).
"""

load("@prelude//:rules.bzl", "toolchain_alias")

python_bootstrap_binary(
    name = "assemble_sysroot",
    main = "assemble_sysroot.py",
    visibility = ["PUBLIC"],
)

python_bootstrap_binary(
    name = "extract_rust_lld",
    main = "extract_rust_lld.py",
    visibility = ["PUBLIC"],
)

python_bootstrap_binary(
    name = "rustc_wrapper",
    main = "rustc_wrapper.py",
    visibility = ["PUBLIC"],
)

# The default rust toolchain. Flip between the rolling `:stable` and
# `:nightly` aliases to change it.
toolchain_alias(
    name = "toolchain",
    actual = "buckshot//rust/toolchains:stable",
    visibility = ["PUBLIC"],
)
