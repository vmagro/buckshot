"""Rule definitions for the versioned node toolchains.

The toolchain instances themselves live in versioned directories (one
generated BUCK per release, nothing else in each directory):

- `node/toolchains/<version>/BUCK` -- e.g. `node/toolchains/v26.5.0`

with rolling `v<major>` aliases in the generated `node/toolchains/BUCK`
(each pointing at the latest release on that major). Generate a new
release with `buck2 run //buckshot -- node toolchain --version vX.Y.Z`
(the output path defaults to the right versioned directory, and the
rolling aliases refresh automatically).

This package holds the rule definitions (`node_toolchain.bzl`) and the
default `toolchain` alias that `toolchains//:node` resolves to. It is
hand-written: never pass it as `--output` (the generator refuses).
"""

load("@prelude//:rules.bzl", "toolchain_alias")

# The default node toolchain. Flip between the rolling `v<major>` aliases
# to change it.
toolchain_alias(
    name = "toolchain",
    actual = "buckshot//node/toolchains:v26",
    visibility = ["PUBLIC"],
)
