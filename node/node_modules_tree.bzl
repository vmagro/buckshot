"""Assembles a real `node_modules/` directory out of buck-fetched
`JsPackageInfo` packages -- either `third-party/npm/defs.bzl`'s
`npm_archive` (generated by `buckshot node npm buckify`) or an in-tree
`node_module` (see `node/node_module.bzl`). Hermetic -- no network access
at build time, every tarball pinned by sha256, the npm equivalent of
what reindeer's vendored crates are for Rust.

`packages` keys are exactly the `package-lock.json` `packages` map keys
with the single leading `node_modules/` stripped (nested overrides keep
their own embedded `node_modules/...` segments, e.g.
`escodegen/node_modules/estraverse`). That's deliberate: npm's lockfile
has already resolved hoisting, so mirroring its keys verbatim as
directory paths and letting Node's own runtime resolver walk up the
tree is correct by construction -- no dependency-resolution logic
needs reimplementing here.

The one wrinkle: a package that has deeper overrides nested inside it
(e.g. `escodegen` has `escodegen/node_modules/estraverse` beneath it)
can't just be placed whole at its own path -- something has to be able
to land *inside* it afterward, taking precedence over anything the
shallower package already put there. `ctx.actions.copied_dir` (real
copies, not symlinks -- Vite/Rollup and some other bundlers realpath
every file they touch, which would walk a symlinked source artifact
straight back out to its real checked-in path, escaping the tree
entirely) resolves a same-destination-path conflict by last-entry-wins,
*not* by path depth -- confirmed empirically, not documented -- so
`build_node_modules_layout` inserts `packages` shallowest-first, which
is what actually makes "deeper override" mean anything regardless of
what order a caller happens to write them in their own `packages` dict.

`base` (an existing prebuilt `node_modules/` dir, e.g. from another
`node_modules_tree` target, to layer `packages` on top of) rides the
same mechanism: inserted before every package entry, so any package
that lands on a path `base` already populated still wins.

`symlink` (default `False`) swaps `copied_dir` for `symlinked_dir` at
the leaves -- both take the same "merged tree of paths -> artifacts"
shape and resolve the same shallowest-first override precedence, they
just differ in whether each leaf is a real copy or a symlink. Real
copies are what `vite_bundle`'s `build`/`serve` need (see that file's
own doc on the realpath-escape issue); its `live` sub_target wants the
opposite -- editing an in-tree `node_module`'s checked-in source and
having the dev server see it live, which a copied snapshot (taken once,
never re-copied just because the original changed) can't do.
"""

load(":providers.bzl", "JsPackageInfo")


def build_node_modules_layout(ctx, name, packages, base=None, symlink=False):
    """Assemble a `<name>/node_modules/` dir and return its Artifact.

    `packages`: dict[str, JsPackageInfo] keyed by node_modules-relative
    path (see this file's own doc for the path convention).
    `base`: optional dep (providing `DefaultInfo`) whose default output is
    an existing `<...>/node_modules/` dir (e.g. a `node_modules_tree`
    target) to shallow-merge at the root -- used to layer `packages` on
    top of a prebuilt third-party tree.
    `symlink`: use `symlinked_dir` instead of `copied_dir` (see this
    file's own doc).
    """
    entries = {}
    if base != None:
        entries["node_modules"] = (
            base[DefaultInfo].default_outputs[0].project("node_modules")
        )

    # Shallowest-first: see this file's own doc for why insertion order,
    # not path depth, is what makes a deeper override actually win.
    for relpath in sorted(packages.keys(), key=lambda p: p.count("/")):
        info = packages[relpath]
        entries["node_modules/" + relpath] = info.package_dir

        # Top-level (non-nested) packages get `.bin` entries.
        if "/node_modules/" not in relpath:
            for binname, binrelpath in info.bin.items():
                binrelpath = binrelpath.removeprefix("./")
                entries["node_modules/.bin/" + binname] = info.package_dir.project(
                    binrelpath
                )

    action = ctx.actions.symlinked_dir if symlink else ctx.actions.copied_dir
    return action(name, entries)


def _node_modules_tree_impl(ctx):
    packages = {
        relpath: dep[JsPackageInfo] for relpath, dep in ctx.attrs.packages.items()
    }
    out = build_node_modules_layout(ctx, "node_modules_tree", packages)
    return [DefaultInfo(default_output=out)]


node_modules_tree = rule(
    impl=_node_modules_tree_impl,
    attrs={
        "packages": attrs.dict(
            attrs.string(),
            attrs.dep(providers=[JsPackageInfo]),
            default={},
            doc="Map of node_modules-relative path (leading `node_modules/` "
            + "stripped once; nested overrides keep embedded "
            + "`node_modules/...` segments) to the `npm_archive` (or other "
            + "`JsPackageInfo`) target providing that path's content.",
        ),
    },
)
