# `vite.config.js` is exported here so `vite_bundle` (see vite_bundle.bzl)
# can use it as the default config -- bundles without an explicit
# `vite_config` all get this exact same one.

load("@prelude//:rules.bzl", "export_file")

export_file(
    name = "vite.config.js",
    src = "vite.config.js",
    visibility = ["PUBLIC"],
)
