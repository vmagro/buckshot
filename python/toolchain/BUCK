"""Rule definitions for the versioned python toolchains.

The toolchain instances themselves live in versioned directories (one
generated BUCK per release, nothing else in each directory):

- `python/toolchains/<version>/BUCK` -- e.g. `python/toolchains/3.14.6`

with rolling `<major>.<minor>` aliases in the generated
`python/toolchains/BUCK` (each pointing at the latest patch release on
that minor). Generate a new release with
`buck2 run //buckshot -- python toolchain --python-version <major.minor>
[--tag <release>]` (the output path defaults to the right versioned
directory, and the rolling aliases refresh automatically).

This package holds the rule definitions (`astral_python.bzl`) and the
default `python` alias that `toolchains//:python` (and
`toolchains//:python_bootstrap`) resolve to. It is hand-written: never
pass it as `--output` (the generator refuses).
"""

load("@prelude//:rules.bzl", "toolchain_alias")

# The default python toolchain. Flip between the rolling `<major>.<minor>`
# aliases to change it.
toolchain_alias(
    name = "python",
    actual = "buckshot//python/toolchains:3.14",
    visibility = ["PUBLIC"],
)
