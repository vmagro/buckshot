load("@buckshot//rust:rust_binary.bzl", "rust_binary")

# buckshot's own maintenance CLI -- see src/main.rs. Lives at the repo root
# (not colocated with either generator's output) since it's a single binary
# serving both `node npm buckify` and `rust toolchain`, neither of which it can
# be colocated with without risking self-clobbering the `BUCK` file it
# generates (see third-party/npm/README.md and rust/toolchain/README.md).
# The wrapper also builds `:buckshot-unittest` from the same sources,
# covering the generator logic's unit tests (run in CI).
#
# Distributed prebuilt via tools/buckshot/stable (dotslash): consumers
# never compile this. In-repo `buck2 run //buckshot` builds from local
# sources instead (external cells can't compile ring's C).
rust_binary(
    name = "buckshot",
    crate_root = "src/main.rs",
    deps = [
        "buckshot//remote_execution/reapid:reapi-cache",
        "buckshot//third-party/rust:anyhow",
        "buckshot//third-party/rust:clap",
        "buckshot//third-party/rust:indicatif",
        "buckshot//third-party/rust:reqwest",
        "buckshot//third-party/rust:ring",
        "buckshot//third-party/rust:serde",
        "buckshot//third-party/rust:serde_json",
        "buckshot//third-party/rust:serde_starlark",
        "buckshot//third-party/rust:tokio",
        "buckshot//third-party/rust:toml",
        "buckshot//third-party/rust:tracing",
        "buckshot//third-party/rust:tracing-subscriber",
    ],
    # The daemon binary doubles as the thing under test: pin its build
    # actions to local execution platforms so building it never requires
    # a running RE daemon (no chicken-and-egg), with or without the
    # `reapid.buckconfig` include selecting the RE-cache platform.
    exec_compatible_with = [
        "buckshot//remote_execution/reapid/platform:platform",
    ],
    srcs = glob(["src/**/*.rs"]),
    visibility = ["PUBLIC"],
)
