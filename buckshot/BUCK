load("@prelude//:rules.bzl", "rust_binary")

# buckshot's own maintenance CLI -- see src/main.rs. Lives at the repo root
# (not colocated with either generator's output) since it's a single binary
# serving both `npm buckify` and `rust toolchain`, neither of which it can
# be colocated with without risking self-clobbering the `BUCK` file it
# generates (see third-party/npm/README.md and rust/toolchain/README.md).
rust_binary(
    name = "buckshot",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/main.rs",
    deps = [
        "buckshot//third-party/rust:anyhow",
        "buckshot//third-party/rust:clap",
        "buckshot//third-party/rust:flate2",
        "buckshot//third-party/rust:maplit",
        "buckshot//third-party/rust:serde",
        "buckshot//third-party/rust:serde_json",
        "buckshot//third-party/rust:serde_starlark",
        "buckshot//third-party/rust:sha2",
        "buckshot//third-party/rust:tar",
        "buckshot//third-party/rust:toml",
    ],
    visibility = ["PUBLIC"],
)
