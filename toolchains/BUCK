load("@prelude//:rules.bzl", "toolchain_alias")
load("@prelude//tests:test_toolchain.bzl", "noop_test_toolchain")
load("@prelude//toolchains:genrule.bzl", "system_genrule_toolchain")
load("@prelude//toolchains:remote_test_execution.bzl", "remote_test_execution_toolchain")

# Hermetic C/C++ toolchain backed by downloaded Zig distributions — no host
# compiler, SDK, or MSVC installation needed. Every `zig <subcommand>` runs
# through a `python_bootstrap_binary` wrapper on the hermetic bootstrap
# interpreter (see cxx/toolchain/zig_tool_wrapper.py), so the same toolchain
# works on mac/linux/windows hosts with no sh/bash involved.
# See cxx/toolchain/README.md for regeneration instructions.
toolchain_alias(
    name = "cxx",
    actual = "buckshot//cxx/toolchain:toolchain",
    visibility = ["PUBLIC"],
)

# Required by prelude//decls/toolchains_common.bzl's cxx toolchain default
# (selected under `config//:none`, which never matches in practice, but the
# target must exist for graph traversal). Just the hermetic toolchain: the
# macro-layer `default_deps` distinction it exists for is fbcode-internal.
toolchain_alias(
    name = "cxx_no_default_deps",
    actual = ":cxx",
    visibility = ["PUBLIC"],
)

toolchain_alias(
    name = "python_bootstrap",
    actual = "buckshot//python/toolchain:python[bootstrap]",
    visibility = ["PUBLIC"],
)

toolchain_alias(
    name = "python",
    actual = "buckshot//python/toolchain:python",
    visibility = ["PUBLIC"],
)

system_genrule_toolchain(
    name = "genrule",
    visibility = ["PUBLIC"],
)

noop_test_toolchain(
    name = "test",
    visibility = ["PUBLIC"],
)

remote_test_execution_toolchain(
    name = "remote_test_execution",
    visibility = ["PUBLIC"],
)

# Rust toolchain — versioned instances live in `rust/toolchains/` (dated
# nightlies under `nightly/<date>`, stables under `stable/<version>`), with
# rolling aliases in the generated `rust/toolchains/BUCK`. The default is
# chosen in `rust/toolchain/BUCK`.
# See rust/toolchain/README.md for regeneration instructions.
toolchain_alias(
    name = "rust",
    actual = "buckshot//rust/toolchain:toolchain",
    visibility = ["PUBLIC"],
)

# Node toolchain — versioned instances live in `node/toolchains/`
# (`node/toolchains/vX.Y.Z`), with rolling `v<major>` aliases in the
# generated `node/toolchains/BUCK`. The default is chosen in
# `node/toolchain/BUCK`.
# Regenerate with `buck2 run //buckshot -- node toolchain --version vX.Y.Z`.
toolchain_alias(
    name = "node",
    actual = "buckshot//node/toolchain:toolchain",
    visibility = ["PUBLIC"],
)
