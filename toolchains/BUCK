    visibility = ["PUBLIC"],
)

remote_test_execution_toolchain(
    name = "remote_test_execution",
    visibility = ["PUBLIC"],
)

# Rust toolchain — generated from a rustup nightly channel TOML.
# See rust/toolchain/README.md for regeneration instructions.
toolchain_alias(
    name = "rust",
    actual = "buckshot//rust/toolchain:toolchain",
    visibility = ["PUBLIC"],
)

# Node toolchain — generated from a nodejs.org release's SHASUMS256.txt.
# Regenerate with `buck2 run //buckshot -- node toolchain --version vX.Y.Z`.
toolchain_alias(
    name = "node",
    actual = "buckshot//node/toolchain:toolchain",
    visibility = ["PUBLIC"],
)
