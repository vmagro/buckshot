load("@prelude//:rules.bzl", "toolchain_alias")
load("@prelude//tests:test_toolchain.bzl", "noop_test_toolchain")
load("@prelude//toolchains:cxx.bzl", "system_cxx_toolchain")
load("@prelude//toolchains:genrule.bzl", "system_genrule_toolchain")
load("@prelude//toolchains:python.bzl", "system_python_bootstrap_toolchain", "system_python_toolchain")
load("@prelude//toolchains:remote_test_execution.bzl", "remote_test_execution_toolchain")

# Default system toolchains — these resolve tools from $PATH on the build host.
#
# For non-macos targets, route to a matching remote exec platform instead of
# running locally: the host's tools (macOS's ar, notably) don't match what
# system_cxx_toolchain assumes for the target os (e.g. archiver_supports_argfiles
# is true for any non-macos target, but macOS's ar doesn't support @argfiles).
# See platforms/exec/BUCK for the NativeLink worker this falls through to.
system_cxx_toolchain(
    name = "cxx",
    exec_compatible_with = select({
        "DEFAULT": [],
        "prelude//os:linux": ["prelude//os/constraints:linux"],
        "prelude//os:macos": ["prelude//os/constraints:macos"],
        "prelude//os:windows": ["prelude//os/constraints:windows"],
    }),
    visibility = ["PUBLIC"],
)

system_python_bootstrap_toolchain(
    name = "python_bootstrap",
    visibility = ["PUBLIC"],
)

system_python_toolchain(
    name = "python",
    visibility = ["PUBLIC"],
)

system_genrule_toolchain(
    name = "genrule",
    visibility = ["PUBLIC"],
)

noop_test_toolchain(
    name = "test",
    visibility = ["PUBLIC"],
)

remote_test_execution_toolchain(
    name = "remote_test_execution",
    visibility = ["PUBLIC"],
)

# Rust toolchain — generated from a rustup nightly channel TOML.
# See rust/toolchain/README.md for regeneration instructions.
toolchain_alias(
    name = "rust",
    actual = "buckshot//rust/toolchain:toolchain",
    visibility = ["PUBLIC"],
)
