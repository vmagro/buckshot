    name="linux-arm64-worker",
    cpu_configuration="prelude//cpu:arm64",
    os_configuration="prelude//os:linux",
    remote_execution_properties={
        "CPU": "arm64",
        "OS": "linux",
    },
    visibility=["PUBLIC"],
)

