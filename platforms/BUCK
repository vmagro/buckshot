"""Target platform definitions -- pass one to `--target-platforms` to
configure a build for that os/cpu combination, independent of whatever
platform buck2 is actually invoked from.

These are configuration-only (`platform()` from the prelude, providing
`PlatformInfo`). They say nothing about *where* the resulting actions
run -- see `platforms/exec/` for the execution-platform side (routing
linux builds to a NativeLink remote worker, since this repo's dev
machines are macOS and can't natively produce Linux ELF binaries).
"""

load("@prelude//platforms:defs.bzl", "execution_platform", "host_configuration")

alias(
    name = "host",
    actual = ":{}-{}".format(
        host_configuration.os.removeprefix("prelude//os:"),
        host_configuration.cpu.removeprefix("prelude//cpu:"),
    ),
    visibility = ["PUBLIC"],
)

execution_platform(
    name = "macos-arm64",
    cpu_configuration = "prelude//cpu:arm64",
    os_configuration = "prelude//os:macos",
    use_windows_path_separators = False,
    visibility = ["PUBLIC"],
)

execution_platform(
    name = "linux-x86_64",
    cpu_configuration = "prelude//cpu:x86_64",
    os_configuration = "prelude//os:linux",
    use_windows_path_separators = False,
    visibility = ["PUBLIC"],
)

execution_platform(
    name = "linux-arm64",
    cpu_configuration = "prelude//cpu:arm64",
    os_configuration = "prelude//os:linux",
    use_windows_path_separators = False,
    visibility = ["PUBLIC"],
)

execution_platform(
    name = "windows-x86_64",
    cpu_configuration = "prelude//cpu:x86_64",
    os_configuration = "prelude//os:windows",
    use_windows_path_separators = True,
    visibility = ["PUBLIC"],
)
