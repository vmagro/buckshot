[cells]
  buckshot = .
  toolchains = toolchains
  tests = tests
  prelude = buck2-prelude
  none = none

[cell_aliases]
  config = prelude
  ovr_config = prelude
  fbcode = none
  fbsource = none
  fbcode_macros = none
  buck = none

[parser]
  target_platform_detector_spec = \
    target:buckshot//...->buckshot//platforms:host \
    target:tests//...->buckshot//platforms:host \
    target:toolchains//...->buckshot//platforms:host \

# No [build] execution_platforms / [buck2_re_client]: everything runs on
# buck2's default local execution platform (prelude//platforms:default).
[project]
  ignore = .git,.sl

[buck2]
  sqlite_materializer_state = true
  sqlite_dep_file_state = true