[cells]
  buckshot = .
  toolchains = toolchains
  tests = tests
  prelude = prelude
  none = none

# The prelude cell comes bundled with the buck2 binary (see
# https://buck2.build/docs/users/advanced/external_cells/) instead of a
# vendored directory: the `prelude` path above is conventional only and no
# files are materialized there. `buck2 expand-external-cell` can copy it
# into the repo for inspection.
[external_cells]
  prelude = bundled

[cell_aliases]
  config = prelude
  ovr_config = prelude
  fbcode = none
  fbsource = none
  fbcode_macros = none
  buck = none

[parser]
  target_platform_detector_spec = \
    target:buckshot//...->buckshot//platforms:host \
    target:tests//...->buckshot//platforms:host \
    target:toolchains//...->buckshot//platforms:host \

# Execution always happens locally on the invoking machine
# (`prelude//platforms:default`, which carries the *host* os/cpu
# constraints). This must be set explicitly: without it buck2 falls back to
# its legacy execution platform, which reuses the *target* configuration for
# execution -- so host-side selects behind `attrs.exec_dep` (which Zig,
# rustc, cargo, and python archive to *run*) would resolve the target's
# tools and cross builds would try to execute foreign binaries. With it,
# target-side selects resolve against `--target-platforms` while host-side
# selects resolve against the build host, and every toolchain cross-builds
# via its own flags (`zig cc -target=`, rustc `--target=`).
[build]
  execution_platforms = prelude//platforms:default

[project]
  ignore = .git,.sl

[buck2]
  sqlite_materializer_state = true
  sqlite_dep_file_state = true