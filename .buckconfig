[cells]
  root = .
  toolchains = toolchains
  tests = tests
  third-party = third-party
  prelude = buck2-prelude
  none = none

[cell_aliases]
  config = prelude
  ovr_config = prelude
  fbcode = none
  fbsource = none
  fbcode_macros = none
  buck = none

[parser]
  target_platform_detector_spec = target:root//...->prelude//platforms:default target:tests//...->prelude//platforms:default target:toolchains//...->prelude//platforms:default target:third-party//...->prelude//platforms:default

[build]
  execution_platforms = root//platforms/exec:execution_platforms

# Local NativeLink container (see platforms/exec/) used as the remote
# execution backend for platforms:linux-x86_64 / platforms:linux-aarch64 --
# only reachable/relevant while that container is actually running; the
# default macOS-native build never touches this (its execution platform is
# plain prelude//platforms:default, local-only).
[buck2_re_client]
  engine_address = grpc://localhost:50051
  action_cache_address = grpc://localhost:50051
  cas_address = grpc://localhost:50051
  instance_name = main
  tls = false

[project]
  ignore = .git,.sl
