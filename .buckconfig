[cells]
  root = .
  toolchains = toolchains
  tests = tests
  third-party = third-party
  prelude = buck2-prelude
  none = none

[cell_aliases]
  config = prelude
  ovr_config = prelude
  fbcode = none
  fbsource = none
  fbcode_macros = none
  buck = none

[parser]
  target_platform_detector_spec = target:root//...->prelude//platforms:default target:tests//...->prelude//platforms:default target:toolchains//...->prelude//platforms:default target:third-party//...->prelude//platforms:default

[project]
  ignore = .git,.sl
