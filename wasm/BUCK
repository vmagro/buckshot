# Host wasmtime binary, forwarded as the real exe artifact (no trampoline,
# so the driver can subprocess it directly on every host OS). The select
# MUST live here rather than on the `wasm_test` call: selects resolve in
# the analyzing target's config, and the tests analyze in wasm32 -- only
# behind the rule's `exec_dep` edge does this alias analyze (and select)
# in the host execution config.
alias(
    name = "wasmtime",
    actual = select({
        # Lets explicit cross-config builds analyze this alias where no
        # host arm matches (normally it analyzes in a host config, via
        # the detector or the tests' `exec_dep` edge). Points at CI's
        # host so even then it fetches something plausible on the
        # machine that runs `...` builds unattended.
        "DEFAULT": ":wasmtime-x86_64-unknown-linux-gnu[wasmtime]",
        "buckshot//platforms/configs:linux-arm64": ":wasmtime-aarch64-unknown-linux-gnu[wasmtime]",
        "buckshot//platforms/configs:linux-x86_64": ":wasmtime-x86_64-unknown-linux-gnu[wasmtime]",
        "buckshot//platforms/configs:macos-arm64": ":wasmtime-aarch64-apple-darwin[wasmtime]",
        "buckshot//platforms/configs:windows-x86_64": ":wasmtime-x86_64-pc-windows-msvc[wasmtime.exe]",
    }),
    visibility = ["PUBLIC"],
)

# Assertion driver for `wasm_test` (see `wasm/wasm_test.bzl`): runs one
# `wasmtime run --invoke` case on the hermetic bootstrap interpreter.
python_bootstrap_binary(
    name = "wasm_test_driver",
    main = "wasm_test_driver.py",
    visibility = ["PUBLIC"],
)
