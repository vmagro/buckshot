"""WebAssembly rules and artifacts (`wasm_test`, wasmtime, ...).

`wasm_test` (see `wasm/wasm_test.bzl`) executes a wasm module's exported
function under wasmtime and asserts on stdout; `:wasmtime` is the pinned
interpreter binary it runs on the build host. Home for wasm-specific
rules and artifacts as wasm support grows.
"""

load("@prelude//:rules.bzl", "http_archive")

# wasmtime v49.0.2 (pinned): `wasmtime run --invoke` executes wasm
# modules' exported functions on the host. Same hand-rolled shape as
# `python/ruff` (a fixture, not a toolchain -- no generator).
http_archive(
    name = "wasmtime-aarch64-apple-darwin",
    sha256 = "ea5a79261caa39819b863fd850879428cf90548353e1e5cf9bcbcc4e7addf2c1",
    size_bytes = 9565456,
    strip_prefix = "wasmtime-v49.0.2-aarch64-macos",
    sub_targets = ["wasmtime"],
    urls = ["https://github.com/bytecodealliance/wasmtime/releases/download/v49.0.2/wasmtime-v49.0.2-aarch64-macos.tar.xz"],
    visibility = [],
)

