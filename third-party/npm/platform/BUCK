# Static os+cpu groupings for npm's own `<os>-<cpu>` platform-package
# naming convention (e.g. `@typescript/typescript-darwin-arm64`), so a
# platform-restricted `npm_archive`'s `target_compatible_with` and a
# dependent's conditional `deps` entry can each be a single flat
# `select()`/reference keyed by one target instead of a nested
# `select(select(...))` per (os, cpu) pair.
#
# `name` matches npm's own os/cpu strings (`process.platform`/`process.arch`)
# so the generator (`buckshot/src/npm`) can build a reference straight from
# a lockfile entry's `os`/`cpu` fields without any translation; the
# `constraint_values` are the real buck2 prelude labels those npm strings
# map to (see `buckshot/src/npm/lockfile.rs`'s `map_os`/`map_cpu`).
#
# Exhaustive over every (os, cpu) buckify currently knows how to map, so
# this shouldn't need to change unless that mapping grows -- hand-written
# and static, not regenerated by `npm buckify`.

load("@prelude//:rules.bzl", "config_setting")

config_setting(
    name = "darwin-x64",
    constraint_values = [
        "prelude//os/constraints:macos",
        "prelude//cpu/constraints:x86_64",
    ],
    visibility = ["PUBLIC"],
)

config_setting(
    name = "darwin-ia32",
    constraint_values = [
        "prelude//os/constraints:macos",
        "prelude//cpu/constraints:x86_32",
    ],
    visibility = ["PUBLIC"],
)

config_setting(
    name = "darwin-arm64",
    constraint_values = [
        "prelude//os/constraints:macos",
        "prelude//cpu/constraints:arm64",
    ],
    visibility = ["PUBLIC"],
)

config_setting(
    name = "darwin-arm",
    constraint_values = [
        "prelude//os/constraints:macos",
        "prelude//cpu/constraints:arm32",
    ],
    visibility = ["PUBLIC"],
)

config_setting(
    name = "darwin-riscv64",
    constraint_values = [
        "prelude//os/constraints:macos",
        "prelude//cpu/constraints:riscv64",
    ],
    visibility = ["PUBLIC"],
)

