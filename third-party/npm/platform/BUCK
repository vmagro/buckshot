# Static os+cpu aliases for npm's own `<os>-<cpu>` platform-package naming
# convention (e.g. `@typescript/typescript-darwin-arm64`), so a
# platform-restricted `npm_archive`'s `target_compatible_with` and a
# dependent's conditional `deps` entry can each be a single flat
# `select()`/reference keyed by one target instead of a nested
# `select(select(...))` per (os, cpu) pair.
#
# `name` matches npm's own os/cpu strings (`process.platform`/`process.arch`)
# so the generator (`buckshot/src/npm`) can build a reference straight from
# a lockfile entry's `os`/`cpu` fields without any translation; each `actual`
# points at the matching canonical `config_setting` in platforms/configs/BUCK
# (see that package for the real `constraint_values` an npm os/cpu string
# maps to -- buckshot/src/npm/lockfile.rs's `map_os`/`map_cpu`).
#
# Exhaustive over every (os, cpu) buckify currently knows how to map, so
# this shouldn't need to change unless that mapping grows -- hand-written
# and static, not regenerated by `node npm buckify`.

alias(
    name = "darwin-x64",
    actual = "buckshot//platforms/configs:macos-x86_64",
    visibility = ["PUBLIC"],
)

alias(
    name = "darwin-ia32",
    actual = "buckshot//platforms/configs:macos-x86_32",
    visibility = ["PUBLIC"],
)

alias(
    name = "darwin-arm64",
    actual = "buckshot//platforms/configs:macos-arm64",
    visibility = ["PUBLIC"],
)

alias(
    name = "darwin-arm",
    actual = "buckshot//platforms/configs:macos-arm32",
    visibility = ["PUBLIC"],
)

alias(
    name = "darwin-riscv64",
    actual = "buckshot//platforms/configs:macos-riscv64",
    visibility = ["PUBLIC"],
)

