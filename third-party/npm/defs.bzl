"""`npm_archive` -- the npm-world equivalent of reindeer's per-crate
`http_archive` + `cargo.rust_library` pair.

`BUCK` (generated by `tools/npm_buckify`, checked in like a Rust
`third-party/BUCK`) calls `npm_archive` once per resolved package from a
`package-lock.json`, wrapping a prelude `http_archive` fetch of the
exact registry tarball with a thin rule that exposes `JsPackageInfo` so
`node_modules_tree` (see `toolchains/npm.bzl`) can consume it like any
other buck-built JS package.
"""

load("@toolchains//:npm.bzl", "JsPackageInfo")

def _npm_archive_impl(ctx):
    raw = ctx.attrs.archive[DefaultInfo].default_outputs[0]

    # Peel off the tarball's top-level wrapper directory via `project()`
    # (a pure buck2 path operation) rather than the `http_archive` rule's
    # own `strip_prefix` (which shells out to `tar` and word-splits the
    # prefix on whitespace -- breaks for real npm tarballs like
    # `@types/node`'s, whose top-level dir is literally `node v22.19`).
    pkg_dir = raw.project(ctx.attrs.strip_prefix) if ctx.attrs.strip_prefix else raw

    return [
        DefaultInfo(default_output = pkg_dir),
        JsPackageInfo(
            package_name = ctx.attrs.package_name,
            package_dir = pkg_dir,
            bin = ctx.attrs.bin,
        ),
    ]

npm_archive = rule(
    impl = _npm_archive_impl,
    attrs = {
        "archive": attrs.dep(
            providers = [DefaultInfo],
            doc = "`http_archive` target for this package's fetched+unpacked " +
                  "registry tarball, with no `strip_prefix` of its own -- this " +
                  "rule peels the wrapper directory off itself (see `strip_prefix`).",
        ),
        "package_name": attrs.string(
            doc = "npm-style package name, e.g. `@babel/core`.",
        ),
        "strip_prefix": attrs.option(
            attrs.string(),
            default = None,
            doc = "Tarball's actual top-level directory name (usually " +
                  "`package`, but not universally -- some tarballs use a " +
                  "different name, occasionally containing spaces). Peeled " +
                  "off via `Artifact.project()`, not `http_archive`'s own " +
                  "`strip_prefix` attr.",
        ),
        "bin": attrs.dict(
            attrs.string(),
            attrs.string(),
            default = {},
            doc = "binname -> path (relative to the package dir) for every " +
                  "entry in this package's own `package.json#bin`. Only " +
                  "consumed for packages placed at a top-level (non-nested) " +
                  "node_modules path -- see `node_modules_tree`.",
        ),
    },
)
