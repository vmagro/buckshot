# Hermetic npm example: `picocolors` pinned + fetched via
# `buckshot npm buckify` into `third-party/npm/BUCK`, generated from
# `third-party/npm/package-lock.json` (regenerate with
# `buck2 run //buckshot -- npm buckify`).
# No network access at build time -- every tarball is content-addressed
# by the sha256 baked into third-party/npm/BUCK. This target builds its
# own `node_modules_tree` naming only the package it actually uses --
# see tests/npm/transitive_deps for a multi-package example.

load("@prelude//:rules.bzl", "genrule")
load("@toolchains//:npm.bzl", "node_modules_tree")

node_modules_tree(
    name = "node_modules",
    packages = {
        "picocolors": "third-party//npm:picocolors",
    },
)

genrule(
    name = "hermetic_smoke",
    out = "out.txt",
    cmd = """NODE_PATH=$(location :node_modules)/node_modules node -e "require('fs').writeFileSync(process.argv[1], require('picocolors').red('hello, hermetic npm!') + String.fromCharCode(10))" "$OUT" """,
)
