# Non-hermetic npm example: `npm_build` shells out to a real
# `npm install && npm run build` inside a buck-managed work tree. This
# package has zero dependencies, so no registry access actually
# happens, but the action is still `local_only` (see toolchains/npm.bzl)
# because in general `npm install` does hit the network.

load("@toolchains//:npm.bzl", "npm_build")

npm_build(
    name = "app",
    srcs = ["package.json"],
    visibility = ["PUBLIC"],
)
