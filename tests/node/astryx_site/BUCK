# A minimal Astryx (https://github.com/facebook/astryx) + React "hello
# world", bundled with `vite_bundle` (see `node/vite_bundle.bzl`).
#
# `deps` is the full, explicit, hand-verified transitive *required*
# dependency closure of vite / @vitejs/plugin-react / react / react-dom /
# @astryxdesign/core / @astryxdesign/theme-neutral, walked straight from
# `third-party/npm/package-lock.json`'s own `dependencies` edges --
# including `@stylexjs/stylex`, which `@astryxdesign/core` only declares
# as a `peerDependencies` entry (so it's never picked up automatically;
# `Button`/`Text` import it directly at runtime for their StyleX-based
# styling). Platform-specific optional native bindings (rolldown/
# lightningcss) are *not* listed here -- they ride along automatically
# via `vite`'s own already-`select()`-gated `deps` (see
# `buckshot/src/npm/lockfile.rs`), merged in through its `JsPackageInfo`.

load("@buckshot//node:vite_bundle.bzl", "vite_bundle")

vite_bundle(
    name="astryx_site",
    srcs=[
        "index.html",
        "package.json",
        "src/App.tsx",
        "src/index.css",
        "src/main.tsx",
    ],
    deps=[
        "//node/node_module/colors:colors",
        "buckshot//third-party/npm:@astryxdesign+core",
        "buckshot//third-party/npm:@astryxdesign+theme-neutral",
        "buckshot//third-party/npm:@oxc-project+types",
        "buckshot//third-party/npm:@rolldown+pluginutils",
        "buckshot//third-party/npm:@stylexjs+stylex",
        "buckshot//third-party/npm:@vitejs+plugin-react",
        "buckshot//third-party/npm:css-mediaquery",
        "buckshot//third-party/npm:detect-libc",
        "buckshot//third-party/npm:fdir",
        "buckshot//third-party/npm:invariant",
        "buckshot//third-party/npm:js-tokens",
        "buckshot//third-party/npm:lightningcss",
        "buckshot//third-party/npm:loose-envify",
        "buckshot//third-party/npm:lucide-react",
        "buckshot//third-party/npm:nanoid",
        "buckshot//third-party/npm:picocolors",
        "buckshot//third-party/npm:picomatch",
        "buckshot//third-party/npm:postcss",
        "buckshot//third-party/npm:react",
        "buckshot//third-party/npm:react-dom",
        "buckshot//third-party/npm:rolldown",
        "buckshot//third-party/npm:scheduler",
        "buckshot//third-party/npm:source-map-js",
        "buckshot//third-party/npm:styleq",
        "buckshot//third-party/npm:tinyglobby",
        "buckshot//third-party/npm:vite",
    ],
    visibility=["PUBLIC"],
)
