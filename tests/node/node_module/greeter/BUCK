# Proves `node_module` (an in-tree, user-authored package) composes with
# both another `node_module` (`colors`, same cell) and an `npm_archive`
# (`picocolors`, a *different* cell -- `third-party`) through the same
# `JsPackageInfo.node_modules` dict (see `node/node_module.bzl`).
#
# `main` (rather than `bin = {"greet": ...}`) means this is *the*
# executable for the package, so `buck2 run :greeter` runs it directly,
# with no `[greet]` sub_target needed.

load("@buckshot//node:node_module.bzl", "node_module")

node_module(
    name = "greeter",
    srcs = [
        "bin/greet.js",
        "package.json",
    ],
    main = "./bin/greet.js",
    deps = [
        "tests//node/node_module/colors:colors",
        "third-party//npm:picocolors",
    ],
    visibility = ["PUBLIC"],
)
