"""Rust-to-wasm compilation tests.

`:guest` is a plain rust library; `:guest-wasm` wraps its `cdylib` as a
standalone `.wasm` module. The `wasm_module` macro (see
`wasm/wasm_module.bzl`) pins the module to `buckshot//platforms:wasm32`
and marks it compatible only with the wasm32 cpu, so the `:guest` dep --
which inherits the module's configuration -- compiles to
`wasm32-unknown-unknown` and links through `zig wasm-ld` with no
per-target flags: rustc targets wasm via the toolchain's `cpu-wasm32`
select arms, and the prelude names the `cdylib` output `*.wasm` for the
cxx toolchain's `wasm` linker flavor. The `wasm_test`s pin wasm32 the
same way, so this package needs no `target_platform_detector_spec` entry.
Host-ness comes only from `exec` edges: `wasm_test` pulls wasmtime
(`buckshot//wasm:wasmtime`) and its driver via `exec_dep`, and `buck2
test` runs the test command on the build host.

`unittests` stays off on `:guest`: buck2 cannot run a wasm test binary
natively; wasmtime is the runner here.
"""

load("@buckshot//rust:rust_library.bzl", "rust_library")
load("@buckshot//wasm:wasm_module.bzl", "wasm_module")
load("@buckshot//wasm:wasm_test.bzl", "wasm_test")

rust_library(
    name = "guest",
    crate_root = "guest.rs",
    srcs = ["guest.rs"],
    unittests = False,
    visibility = ["PUBLIC"],
)

wasm_module(
    name = "guest-wasm",
    dep = ":guest",
    visibility = ["PUBLIC"],
)

wasm_test(
    name = "add",
    args = ["1", "2"],
    expected_stdout = "3",
    invoke = "add",
    module = ":guest-wasm",
    wasmtime = "buckshot//wasm:wasmtime",
)

wasm_test(
    name = "fib",
    args = ["10"],
    expected_stdout = "55",
    invoke = "fib",
    module = ":guest-wasm",
    wasmtime = "buckshot//wasm:wasmtime",
)
