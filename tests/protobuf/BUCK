load("@buckshot//protobuf:protobuf_library.bzl", "protobuf_library")
load("@buckshot//rust:rust_test.bzl", "rust_test")

protobuf_library(
    name = "example",
    # Same values as the default; exercises the `runtime_deps` override
    # path a downstream repo with its own vendored tree must use (a
    # second prost instance cannot exist within one tree).
    runtime_deps = [
        "@buckshot//third-party/rust:prost",
        "@buckshot//third-party/rust:prost-types",
    ],
    srcs = ["example.proto"],
)

rust_test(
    name = "example-rust-test",
    crate_root = "example_test.rs",
    deps = [
        ":example-rust",
        "@buckshot//third-party/rust:prost",
    ],
    srcs = ["example_test.rs"],
)

protobuf_library(
    name = "service",
    languages = ["tonic"],
    srcs = ["service.proto"],
    # Same values as the default; exercises the `tonic_runtime_deps`
    # override path a downstream repo with its own vendored tree must use.
    tonic_runtime_deps = [
        "@buckshot//third-party/rust:prost",
        "@buckshot//third-party/rust:prost-types",
        "@buckshot//third-party/rust:tonic",
        "@buckshot//third-party/rust:tonic-prost",
    ],
)

rust_test(
    name = "service-tonic-test",
    crate_root = "service_test.rs",
    deps = [
        ":service-tonic",
        "@buckshot//third-party/rust:tonic",
    ],
    srcs = ["service_test.rs"],
)
